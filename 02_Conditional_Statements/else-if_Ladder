#include <stdio.h>
int main()
{
    int score;
    printf("Enter your exam score (0 - 100): ");
    scanf("%d", &score);

    if (score >= 90) {
        printf("Grade: A (Excellent)\n");
    } 
    else if (score >= 80) {
        printf("Grade: B (Good job)\n");
    } 
    else if (score >= 70) {
        printf("Grade: C (Well done)\n");
    } 
    else if (score >= 60) {
        printf("Grade: D (Passed)\n");
    } 
    else if (score >= 0) {
        printf("Grade: F (Failed)\n");
    } 
    else {
        printf("Invalid score entered!\n");
    }

    return 0;
}
